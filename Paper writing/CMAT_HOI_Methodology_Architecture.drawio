<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="CMAT_HOI_Architecture" name="Methodology Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner_title" value="&lt;b&gt;&lt;font style='font-size: 21px; color: #FFFFFF; letter-spacing: 0.5px;'&gt;METHODOLOGY ARCHITECTURAL DIAGRAM: CMAT-HOI SPORTS ACTION RECOGNITION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 13px; color: #94A3B8;'&gt;End-to-End Multimodal Cross-Modal Attention Transformer with Human-Object Interaction Modeling for 82 Fine-Grained Sports Classes&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;shadow=1;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="container_p1" value="&lt;b&gt;PHASE 1: DATASET INGESTION, PREPROCESSING FUNNEL &amp;amp; DISJOINT SPLITTING&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#1E3A8A;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="1580" height="330" as="geometry" />
        </mxCell>
        <mxCell id="box_data_repo" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #1E40AF;'&gt;📁 UCF-101 Sports Action Repository&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #BFDBFE; margin: 6px 0;'&gt;• &lt;b&gt;Total Video Clips:&lt;/b&gt; 9,151 Full Action Videos&lt;br&gt;• &lt;b&gt;Target Categories:&lt;/b&gt; 82 Fine-Grained Classes&lt;br&gt;• &lt;b&gt;Complex Dynamics:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Ball &amp;amp; Racket (Tennis, Basketball, Cricket)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Track &amp;amp; Gymnastics (HighJump, Vault, Floor)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Water &amp;amp; Winter (Surfing, Skiing, Rowing)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Athletics &amp;amp; Combat (Boxing, Fencing, Archery)&lt;br&gt;• &lt;b&gt;Raw Video Format:&lt;/b&gt; RGB .avi / .mp4, 25-30 FPS&lt;br&gt;• &lt;b&gt;Challenges:&lt;/b&gt; Extreme camera motion, severe occlusions, fast apparatus flight, and dynamic background clutter." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="80" y="175" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="box_funnel_head" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #1E40AF;'&gt;⚙️ 5-Stage Sports Video Preprocessing &amp;amp; Conditioning Funnel&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="440" y="175" width="750" height="35" as="geometry" />
        </mxCell>
        <mxCell id="funnel_s1" value="&lt;div style='text-align: left;'&gt;&lt;span style='color: #2563EB; font-size: 11.5px;'&gt;&lt;b&gt;Step 1: Uniform Temporal Discretization&lt;/b&gt;&lt;/span&gt;: &lt;font style='font-size: 10.5px; color: #334155;'&gt;Extract T = 16 equidistant frames spanning full action clip: t_i = floor(i × T_orig / 16)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="217" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="funnel_s2" value="&lt;div style='text-align: left;'&gt;&lt;span style='color: #4F46E5; font-size: 11.5px;'&gt;&lt;b&gt;Step 2: Spatial Resizing &amp;amp; Normalization&lt;/b&gt;&lt;/span&gt;: &lt;font style='font-size: 10.5px; color: #334155;'&gt;Bilinear resize to 224×224 px; ImageNet standard normalization (μ = [0.485, 0.456, 0.406], σ = [0.229, 0.224, 0.225])&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="261" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="funnel_s3" value="&lt;div style='text-align: left;'&gt;&lt;span style='color: #7C3AED; font-size: 11.5px;'&gt;&lt;b&gt;Step 3: Kinematic Velocity Computation&lt;/b&gt;&lt;/span&gt;: &lt;font style='font-size: 10.5px; color: #334155;'&gt;Compute 1st-order temporal difference vectors: Δp_t = p_t - p_(t-1) for body joints &amp;amp; apparatus centroids&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="305" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="funnel_s4" value="&lt;div style='text-align: left;'&gt;&lt;span style='color: #C026D3; font-size: 11.5px;'&gt;&lt;b&gt;Step 4: Apparatus Imputation &amp;amp; Noise Filtering&lt;/b&gt;&lt;/span&gt;: &lt;font style='font-size: 10.5px; color: #334155;'&gt;Zero-filling missing equipment bboxes; Kalman smoothing on joints; frame-wise aspect ratio verification&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAE8FF;strokeColor=#C026D3;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="349" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="funnel_s5" value="&lt;div style='text-align: left;'&gt;&lt;span style='color: #DB2777; font-size: 11.5px;'&gt;&lt;b&gt;Step 5: Pre-Flight Tensor Sanitization&lt;/b&gt;&lt;/span&gt;: &lt;font style='font-size: 10.5px; color: #334155;'&gt;Cast tensors to FP32, sanitize NaN/Inf occurrences, and package synchronized multimodal batches&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="393" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="box_split" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #1E40AF;'&gt;⚖️ Subject-Disjoint Dataset Split&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #BFDBFE; margin: 6px 0;'&gt;&lt;div style='background: #EFF6FF; border: 1px solid #3B82F6; border-radius: 6px; padding: 6px; margin-bottom: 8px;'&gt;&lt;b&gt;🏋️ Training Split (70%)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; font-weight: bold; color: #1D4ED8;'&gt;6,408 Video Clips&lt;/span&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #475569;'&gt;Subject-independent grouping; receives Multimodal Mixup &amp;amp; Kinematic Jitter.&lt;/font&gt;&lt;/div&gt;&lt;div style='background: #F0FDF4; border: 1px solid #16A34A; border-radius: 6px; padding: 6px;'&gt;&lt;b&gt;🎯 Validation &amp;amp; Test Split (30%)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; font-weight: bold; color: #15803D;'&gt;2,743 Video Clips&lt;/span&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #475569;'&gt;Unseen athletes &amp;amp; backgrounds; evaluates real generalization (90.19% Top-1).&lt;/font&gt;&lt;/div&gt;&lt;div style='font-size: 10px; color: #64748B; margin-top: 6px; text-align: center;'&gt;Strict zero-leakage guarantee (no common video sessions).&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1220" y="175" width="400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_1" value="Raw Video Feeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1E40AF;" edge="1" parent="1" source="box_data_repo" target="box_funnel_head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_2" value="Sanitized Tensors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1E40AF;" edge="1" parent="1" source="funnel_s5" target="box_split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="container_p2" value="&lt;b&gt;PHASE 2: SYNCHRONIZED MULTIMODAL FEATURE EXTRACTION (4 PARALLEL TEMPORAL STREAMS, T = 16)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#581C87;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1580" height="270" as="geometry" />
        </mxCell>
        <mxCell id="stream_vis" value="&lt;div style='text-align: center; font-weight: bold; font-size: 12.5px; color: #1E40AF;'&gt;📷 Visual Appearance Stream&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #BFDBFE; margin: 4px 0;'&gt;• &lt;b&gt;Backbone:&lt;/b&gt; ResNet-50 (ImageNet Pretrained)&lt;br&gt;• &lt;b&gt;Layers:&lt;/b&gt; Conv1 to Layer4 (avgpool pooling)&lt;br&gt;• &lt;b&gt;Extracted Tensor:&lt;/b&gt;&lt;br&gt;&lt;div style='text-align: center; background: #DBEAFE; border-radius: 4px; padding: 3px; font-weight: bold; color: #1D4ED8; margin: 4px 0;'&gt;X_vis ∈ ℝ^(16 × 2048)&lt;/div&gt;• &lt;b&gt;Visual Context:&lt;/b&gt; Scene layout, court surfaces, clothing, arena boundaries, actor orientation." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="80" y="525" width="360" height="205" as="geometry" />
        </mxCell>
        <mxCell id="stream_pose" value="&lt;div style='text-align: center; font-weight: bold; font-size: 12.5px; color: #065F46;'&gt;🏃 Skeletal Kinematics Stream&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #A7F3D0; margin: 4px 0;'&gt;• &lt;b&gt;Backbone:&lt;/b&gt; Keypoint R-CNN (ResNet-50-FPN)&lt;br&gt;• &lt;b&gt;Extraction:&lt;/b&gt; 17 Keypoints (x, y, c) = 51-d&lt;br&gt;• &lt;b&gt;Velocities:&lt;/b&gt; First-order Δ(x, y) = 34-d&lt;br&gt;• &lt;b&gt;Extracted Tensor:&lt;/b&gt;&lt;br&gt;&lt;div style='text-align: center; background: #D1FAE5; border-radius: 4px; padding: 3px; font-weight: bold; color: #047857; margin: 4px 0;'&gt;X_pose ∈ ℝ^(16 × 85)&lt;/div&gt;• &lt;b&gt;Biomechanics:&lt;/b&gt; Articulated human posture, joint velocities, limb angles, athletic trajectory." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="470" y="525" width="360" height="205" as="geometry" />
        </mxCell>
        <mxCell id="stream_obj" value="&lt;div style='text-align: center; font-weight: bold; font-size: 12.5px; color: #92400E;'&gt;🎾 Sports Apparatus Stream&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #FDE68A; margin: 4px 0;'&gt;• &lt;b&gt;Backbone:&lt;/b&gt; Faster R-CNN (FPN Backbone)&lt;br&gt;• &lt;b&gt;Extraction:&lt;/b&gt; Top gear candidate per frame&lt;br&gt;• &lt;b&gt;Attributes:&lt;/b&gt; [x1, y1, x2, y2, score, cls, aspect]&lt;br&gt;• &lt;b&gt;Extracted Tensor:&lt;/b&gt;&lt;br&gt;&lt;div style='text-align: center; background: #FEF3C7; border-radius: 4px; padding: 3px; font-weight: bold; color: #B45309; margin: 4px 0;'&gt;X_obj ∈ ℝ^(16 × 7)&lt;/div&gt;• &lt;b&gt;Equipment:&lt;/b&gt; Ball, racket, baseball bat, barbell, skateboard, bow coordinates &amp;amp; motion paths." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="860" y="525" width="360" height="205" as="geometry" />
        </mxCell>
        <mxCell id="stream_hoi" value="&lt;div style='text-align: center; font-weight: bold; font-size: 12.5px; color: #9D174D;'&gt;🤝 Geometric HOI Kinematics Stream&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #FBCFE8; margin: 4px 0;'&gt;• &lt;b&gt;Engine:&lt;/b&gt; Deterministic Kinematic Engine&lt;br&gt;• &lt;b&gt;Interaction Geometry:&lt;/b&gt; Wrists/Ankles ↔ Gear&lt;br&gt;• &lt;b&gt;Features:&lt;/b&gt; Euclidean dist, unit angles, d(dist)/dt&lt;br&gt;• &lt;b&gt;Extracted Tensor:&lt;/b&gt;&lt;br&gt;&lt;div style='text-align: center; background: #FCE7F3; border-radius: 4px; padding: 3px; font-weight: bold; color: #BE185D; margin: 4px 0;'&gt;X_hoi ∈ ℝ^(16 × 16)&lt;/div&gt;• &lt;b&gt;HOI Dynamics:&lt;/b&gt; Ball strike instant, bat grip angle, release moment, landing foot-ground contact." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1250" y="525" width="370" height="205" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_s1" value="Train Batches (6,408 clips)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6B21A8;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_split" target="stream_vis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6B21A8;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_split" target="stream_pose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6B21A8;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_split" target="stream_obj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6B21A8;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_split" target="stream_hoi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="container_p3" value="&lt;b&gt;PHASE 3: CMAT-HOI CORE ARCHITECTURE (CROSS-MODAL ATTENTION TRANSFORMER &amp;amp; GATED FUSION)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=15;fontColor=#78350F;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="1580" height="750" as="geometry" />
        </mxCell>
        <mxCell id="stem_vis" value="&lt;div style='text-align: center; font-weight: bold; font-size: 11px; color: #1E40AF;'&gt;Visual Modality Stem&lt;/div&gt;&lt;font style='font-size: 9.5px; color: #334155;'&gt;1D Conv (k=3, s=1, p=1) + LN + GELU&lt;br&gt;ℝ^(16 × 2048) ──► &lt;b&gt;E_vis ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="815" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stem_pose" value="&lt;div style='text-align: center; font-weight: bold; font-size: 11px; color: #065F46;'&gt;Pose Modality Stem&lt;/div&gt;&lt;font style='font-size: 9.5px; color: #334155;'&gt;1D Conv (k=3, s=1, p=1) + LN + GELU&lt;br&gt;ℝ^(16 × 85) ──► &lt;b&gt;E_pose ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="815" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stem_obj" value="&lt;div style='text-align: center; font-weight: bold; font-size: 11px; color: #92400E;'&gt;Object Modality Stem&lt;/div&gt;&lt;font style='font-size: 9.5px; color: #334155;'&gt;1D Conv (k=3, s=1, p=1) + LN + GELU&lt;br&gt;ℝ^(16 × 7) ──► &lt;b&gt;E_obj ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="815" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stem_hoi" value="&lt;div style='text-align: center; font-weight: bold; font-size: 11px; color: #9D174D;'&gt;HOI Modality Stem&lt;/div&gt;&lt;font style='font-size: 9.5px; color: #334155;'&gt;1D Conv (k=3, s=1, p=1) + LN + GELU&lt;br&gt;ℝ^(16 × 16) ──► &lt;b&gt;E_hoi ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1250" y="815" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_s1_stem" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1E40AF;" edge="1" parent="1" source="stream_vis" target="stem_vis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s2_stem" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#065F46;" edge="1" parent="1" source="stream_pose" target="stem_pose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s3_stem" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#92400E;" edge="1" parent="1" source="stream_obj" target="stem_obj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s4_stem" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#991B1B;" edge="1" parent="1" source="stream_hoi" target="stem_hoi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_cross_attn" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #831843;'&gt;⚡ Bi-Directional Keypoint–Equipment Cross-Attention Mechanism (h = 4 Heads, d_k = 64)&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #F472B6; margin: 5px 0;'&gt;&lt;table width='100%' style='font-size: 11px; color: #1E293B;'&gt;&lt;tr&gt;&lt;td width='50%' style='padding-right: 15px; border-right: 1px dashed #F472B6; vertical-align: top;'&gt;&lt;b&gt;1. Pose Queries Equipment Attention (Pose-Guided Enhancement):&lt;/b&gt;&lt;br&gt;• Query: Q = E_pose &amp;nbsp;|&amp;nbsp; Key: K = E_obj &amp;nbsp;|&amp;nbsp; Value: V = E_obj&lt;br&gt;• Attention Weights: A_P→O = Softmax( (Q · K^T) / sqrt(d_k) ) ∈ ℝ^(16 × 16)&lt;br&gt;• &lt;b&gt;Enhanced Pose: P_enh = LayerNorm( E_pose + MHA(Q, K, V) ) ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #64748B;'&gt;Conditions human joint movements on where sports equipment is currently located.&lt;/font&gt;&lt;/td&gt;&lt;td width='50%' style='padding-left: 15px; vertical-align: top;'&gt;&lt;b&gt;2. Equipment Queries Pose Attention (Equipment-Guided Enhancement):&lt;/b&gt;&lt;br&gt;• Query: Q = E_obj &amp;nbsp;|&amp;nbsp; Key: K = E_pose &amp;nbsp;|&amp;nbsp; Value: V = E_pose&lt;br&gt;• Attention Weights: A_O→P = Softmax( (Q · K^T) / sqrt(d_k) ) ∈ ℝ^(16 × 16)&lt;br&gt;• &lt;b&gt;Enhanced Object: O_enh = LayerNorm( E_obj + MHA(Q, K, V) ) ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #64748B;'&gt;Resolves equipment trajectory ambiguity by attending to player hand/wrist kinematics.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;fillColor=#FDF2F8;strokeColor=#BE185D;strokeWidth=2;html=1;align=left;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="905" width="990" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e_stem_pose_cross" value="E_pose (256-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#991B1B;;entryX=0.25;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="stem_pose" target="box_cross_attn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_stem_obj_cross" value="E_obj (256-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#991B1B;;entryX=0.75;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="stem_obj" target="box_cross_attn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_gmfu" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #78350F;'&gt;🎛️ Gated Multimodal Fusion Unit (GMFU) — Dynamic Frame-Level Modality Weighting&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #FCD34D; margin: 5px 0;'&gt;&lt;table width='100%' style='font-size: 11px; color: #1E293B;'&gt;&lt;tr&gt;&lt;td width='55%' style='vertical-align: top;'&gt;• &lt;b&gt;Modality Gating Vector:&lt;/b&gt; &lt;span style='color: #B45309; font-weight: bold;'&gt;g_t = Softmax( W_g · [ E_vis,t ; P_enh,t ; O_enh,t ; E_hoi,t ] + b_g ) ∈ ℝ^4&lt;/span&gt;&lt;br&gt;• &lt;b&gt;Dynamic Fused Token:&lt;/b&gt; &lt;span style='color: #B45309; font-weight: bold;'&gt;F_t = g_t,1 · E_vis,t + g_t,2 · P_enh,t + g_t,3 · O_enh,t + g_t,4 · E_hoi,t ∈ ℝ^256&lt;/span&gt;&lt;br&gt;• &lt;b&gt;Full Sequence:&lt;/b&gt; Fused Feature Matrix &lt;b&gt;F = [F_1, F_2, ..., F_16]^T ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/td&gt;&lt;td width='45%' style='vertical-align: top; background: #FEF9C3; border-radius: 4px; padding: 6px; border: 1px solid #F59E0B;'&gt;&lt;b&gt;Adaptive Modality Trust Allocation:&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #451A03;'&gt;• Suppresses occluded keypoints during sudden body turns.&lt;br&gt;• Amplifies visual context during outdoor sports (e.g., Surfing, Skiing).&lt;br&gt;• Prioritizes HOI kinematic vectors during decisive ball-impact frames.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;fillColor=#FEF9C3;strokeColor=#D97706;strokeWidth=2;html=1;align=left;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1050" width="1420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_stem_vis_gmfu" value="E_vis (256-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#92400E;;entryX=0.1;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="stem_vis" target="box_gmfu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cross_gmfu" value="[P_enh; O_enh] (512-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#92400E;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_cross_attn" target="box_gmfu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_stem_hoi_gmfu" value="E_hoi (256-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#92400E;;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="stem_hoi" target="box_gmfu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_trans" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13.5px; color: #064E3B;'&gt;🧠 Spatio-Temporal Transformer Encoder (Pre-LayerNorm, 3 Stacked Layers)&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #6EE7B7; margin: 5px 0;'&gt;&lt;table width='100%' style='font-size: 11px; color: #1E293B;'&gt;&lt;tr&gt;&lt;td width='40%' style='vertical-align: top; border-right: 1px dashed #6EE7B7; padding-right: 10px;'&gt;&lt;b&gt;1. Token Sequence &amp;amp; Positional Encoding:&lt;/b&gt;&lt;br&gt;• Prepend Learnable Class Token: &lt;b&gt;z_CLS ∈ ℝ^256&lt;/b&gt;&lt;br&gt;• Add Fixed Sinusoidal Positional Encoding: &lt;b&gt;E_pos ∈ ℝ^(17 × 256)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Input Matrix: Z_0 = [ z_CLS ; F_1 ; F_2 ; ... ; F_16 ] + E_pos ∈ ℝ^(17 × 256)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #047857;'&gt;Preserves exact temporal sequence ordering without temporal collapse.&lt;/font&gt;&lt;/td&gt;&lt;td width='35%' style='vertical-align: top; border-right: 1px dashed #6EE7B7; padding: 0 10px;'&gt;&lt;b&gt;2. Stacked Transformer Block Architecture:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;3 Stacked Encoder Layers:&lt;/b&gt; l = 1, 2, 3&lt;br&gt;• &lt;b&gt;Multi-Head Self-Attention:&lt;/b&gt; h = 8 heads, d_k = 32&lt;br&gt;• &lt;b&gt;Feed-Forward Network:&lt;/b&gt; d_ff = 1024 with GELU activation&lt;br&gt;• &lt;b&gt;LayerNorm &amp;amp; Residuals:&lt;/b&gt; Z'_l = MSA(LN(Z_(l-1))) + Z_(l-1)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Z_l = FFN(LN(Z'_l)) + Z'_l&lt;/td&gt;&lt;td width='25%' style='vertical-align: top; padding-left: 10px;'&gt;&lt;b&gt;3. Output Latents:&lt;/b&gt;&lt;br&gt;• Sequence Tokens: &lt;b&gt;Z_final ∈ ℝ^(17 × 256)&lt;/b&gt;&lt;br&gt;• Captures long-range athletic dependencies across start, apex, and follow-through.&lt;br&gt;• Dropout: p = 0.1 for attention &amp;amp; FFN.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;html=1;align=left;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1175" width="1420" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e_gmfu_trans" value="Fused Tokens F ∈ ℝ^(16 × 256)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#065F46;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_gmfu" target="box_trans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_pool_head" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #155E75;'&gt;📊 Multi-Scale 4-Way Temporal Pooling Mechanism (Comprehensive Action Dynamics)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="140" y="1325" width="1420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p_cls" value="&lt;div style='text-align: center; color: #0284C7; font-size: 11.5px;'&gt;&lt;b&gt;1. [z_CLS] Token&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align: center; font-size: 10px; margin-top: 3px;'&gt;z_cls = Z_final[0] ∈ ℝ^256&lt;br&gt;&lt;font style='font-size: 10px; color: #475569;'&gt;Learned global contextual action summary across entire clip.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="140" y="1365" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p_attn" value="&lt;div style='text-align: center; color: #0D9488; font-size: 11.5px;'&gt;&lt;b&gt;2. Temporal Attention Pooling&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align: center; font-size: 10px; margin-top: 3px;'&gt;z_Attn = ∑_(t=1)^16 α_t · Z_final[t] ∈ ℝ^256&lt;br&gt;&lt;font style='font-size: 10px; color: #475569;'&gt;Learned saliency weights α_t focus on peak impact moments.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="1365" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p_max" value="&lt;div style='text-align: center; color: #4338CA; font-size: 11.5px;'&gt;&lt;b&gt;3. Global Max Pooling&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align: center; font-size: 10px; margin-top: 3px;'&gt;z_Max = max_(t=1..16) (Z_final[t]) ∈ ℝ^256&lt;br&gt;&lt;font style='font-size: 10px; color: #475569;'&gt;Captures extreme instantaneous athletic spikes (e.g. smash, jump).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="1365" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p_avg" value="&lt;div style='text-align: center; color: #6D28D9; font-size: 11.5px;'&gt;&lt;b&gt;4. Global Average Pooling&lt;/b&gt;&lt;/div&gt;&lt;div style='text-align: center; font-size: 10px; margin-top: 3px;'&gt;z_Avg = (1/16) ∑_(t=1)^16 Z_final[t] ∈ ℝ^256&lt;br&gt;&lt;font style='font-size: 10px; color: #475569;'&gt;Captures sustained background rhythm and full-motion baseline.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1365" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="box_concat" value="&lt;div style='text-align: center; font-weight: bold; font-size: 12px; color: #0E7490;'&gt;🔗 Concatenation: Z_pool = [ z_CLS ; z_Attn ; z_Max ; z_Avg ] ∈ ℝ^1024  (Unified Rich Multi-Scale Sports Action Descriptor)&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="1450" width="1420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="e_trans_pool" value="Transformer Latents Z_final ∈ ℝ^(17 × 256)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_trans" target="box_pool_head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p_cls_concat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="p_cls" target="box_concat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p_attn_concat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="p_attn" target="box_concat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p_max_concat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="p_max" target="box_concat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p_avg_concat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="p_avg" target="box_concat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="container_p4" value="&lt;b&gt;PHASE 4: OPTIMIZATION, LOSS FORMULATION &amp;amp; RIGOROUS MODEL EVALUATION&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#991B1B;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1540" width="1580" height="420" as="geometry" />
        </mxCell>
        <mxCell id="box_mlp" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #991B1B;'&gt;🎯 3-Layer MLP Classifier &amp;amp; Optimization&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #FCA5A5; margin: 5px 0;'&gt;• &lt;b&gt;Classifier Architecture:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Layer 1: Linear(1024 ──► 512) + LayerNorm + GELU + Dropout(0.3)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Layer 2: Linear(512 ──► 256) + LayerNorm + GELU + Dropout(0.2)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Layer 3: Linear(256 ──► 82) ──► Logits ŷ ∈ ℝ^82&lt;br&gt;• &lt;b&gt;Optimizer:&lt;/b&gt; AdamW (Learning Rate = 1e-4, Weight Decay = 1e-2)&lt;br&gt;• &lt;b&gt;Learning Rate Scheduler:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- CosineAnnealingLR (T_max = 30, η_min = 1e-6)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Linear Warmup for first 5 epochs (stability)&lt;br&gt;• &lt;b&gt;Data Augmentation Strategy:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Multimodal Mixup: x̃ = λx_i + (1-λ)x_j, λ ~ Beta(0.4, 0.4)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Kinematic Jitter: N(0, 0.008^2) Gaussian perturbation on joints&lt;br&gt;&amp;nbsp;&amp;nbsp;- Temporal Frame Dropout: Random frame zeroing (p = 0.1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="80" y="1585" width="470" height="350" as="geometry" />
        </mxCell>
        <mxCell id="box_loss" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #991B1B;'&gt;⚖️ Focal Loss with Label Smoothing Regularization&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #FCA5A5; margin: 5px 0;'&gt;&lt;div style='text-align: center; background: #FEF2F2; border: 1.5px solid #EF4444; border-radius: 6px; padding: 6px; margin: 6px 0;'&gt;&lt;b style='font-size: 12px; color: #B91C1C;'&gt;L_total = - ∑_(c=1)^82 α_c · (1 - p_c)^γ · y_c^(smooth) · log(p_c)&lt;/b&gt;&lt;/div&gt;• &lt;b&gt;Focusing Hyperparameter (γ = 1.5):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Down-weights easy, well-classified actions (e.g. Walking, Running), forcing gradient updates to focus on hard, fine-grained sports (e.g. TennisSwing vs. BadmintonSmash).&lt;br&gt;• &lt;b&gt;Class Weighting (α_c = 0.08):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Compensates for class frequency variances across 82 categories.&lt;br&gt;• &lt;b&gt;Label Smoothing (ε = 0.08):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;span style='color: #7F1D1D;'&gt;y_c^(smooth) = (1 - ε) · y_c + (ε / 82)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Prevents softmax overconfidence on visually ambiguous actions.&lt;br&gt;• &lt;b&gt;Gradient Backpropagation:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Drives end-to-end parameter updates through Transformer &amp;amp; Stems." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="580" y="1585" width="480" height="350" as="geometry" />
        </mxCell>
        <mxCell id="box_eval" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #15803D;'&gt;🏆 Generalization Evaluation &amp;amp; Peak Milestone&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #86EFAC; margin: 5px 0;'&gt;• &lt;b&gt;Evaluation Set:&lt;/b&gt; 2,743 Disjoint Test Clips (Zero Leakage)&lt;br&gt;&lt;div style='background: #DCFCE7; border: 1.5px solid #16A34A; border-radius: 6px; padding: 8px; margin: 8px 0; text-align: center;'&gt;&lt;span style='font-size: 13px; font-weight: bold; color: #14532D;'&gt;PEAK VALIDATION MILESTONE (EPOCH 23)&lt;/span&gt;&lt;br&gt;&lt;table width='100%' style='margin-top: 4px; font-size: 11.5px; font-weight: bold;'&gt;&lt;tr&gt;&lt;td style='color: #15803D;'&gt;Top-1 Accuracy:&lt;/td&gt;&lt;td style='color: #15803D; font-size: 13px;'&gt;90.19%&lt;/td&gt;&lt;td style='color: #15803D;'&gt;Top-5 Accuracy:&lt;/td&gt;&lt;td style='color: #15803D; font-size: 13px;'&gt;99.02%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #15803D;'&gt;Validation Loss:&lt;/td&gt;&lt;td style='color: #15803D;'&gt;0.4397&lt;/td&gt;&lt;td style='color: #15803D;'&gt;Macro F1-Score:&lt;/td&gt;&lt;td style='color: #15803D;'&gt;90.19%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;• &lt;b&gt;Diagnostic Tools &amp;amp; Verification:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- 82×82 Normalized Confusion Matrix (low inter-class confusion)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Saliency Attention Weight Heatmaps (sharp temporal localization)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Early Stopping monitor with patience = 7 epochs&lt;br&gt;• &lt;b&gt;Artifact Checkpoint:&lt;/b&gt; Serialized &lt;span style='font-family: monospace; font-weight: bold; color: #15803D;'&gt;best_model.pt&lt;/span&gt; with full state dict and optimizer states for real-time deployment." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1585" width="520" height="350" as="geometry" />
        </mxCell>
        <mxCell id="e_concat_mlp" value="Z_pool (1024-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#991B1B;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.2;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_concat" target="box_mlp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mlp_loss" value="Logits ŷ ∈ ℝ^82" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#991B1B;;entryX=0.0;entryY=0.4;entryDx=0;entryDy=0;exitX=1.0;exitY=0.4;exitDx=0;exitDy=0" edge="1" parent="1" source="box_mlp" target="box_loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_loss_backprop" value="∇ Loss (Backpropagation)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#991B1B;;entryX=0.7;entryY=1.0;entryDx=0;entryDy=0;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_loss" target="box_trans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_test_eval" value="30% Test Set (2,743 clips)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#065F46;;entryX=0.8;entryY=0.0;entryDx=0;entryDy=0;exitX=0.8;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_split" target="box_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mlp_eval" value="Epoch Checkpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#065F46;;entryX=0.0;entryY=0.75;entryDx=0;entryDy=0;exitX=1.0;exitY=0.75;exitDx=0;exitDy=0" edge="1" parent="1" source="box_mlp" target="box_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="container_p5" value="&lt;b&gt;PHASE 5: REAL-TIME INFERENCE PIPELINE &amp;amp; MULTI-PLATFORM DEPLOYMENT&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;verticalAlign=top;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#115E59;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1980" width="1580" height="370" as="geometry" />
        </mxCell>
        <mxCell id="box_live" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #115E59;'&gt;📹 Live Stream &amp;amp; Circular Queue&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #99F6E4; margin: 5px 0;'&gt;• &lt;b&gt;Real-Time Video Sources:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- 30+ FPS Live USB/CSI Webcam feed&lt;br&gt;&amp;nbsp;&amp;nbsp;- Unseen match broadcast (.mp4 / .avi)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Synthetic edge simulation test stream&lt;br&gt;• &lt;b&gt;Circular Sliding Window Buffer:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Queue Length: T = 16 frames&lt;br&gt;&amp;nbsp;&amp;nbsp;- Rolling stride = 1 frame (continuous prediction)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Thread-safe asynchronous video capture&lt;br&gt;&amp;nbsp;&amp;nbsp;- Zero frame dropping with hardware decoders" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="80" y="2025" width="430" height="305" as="geometry" />
        </mxCell>
        <mxCell id="box_engine" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #115E59;'&gt;⚡ ActionInferenceEngine (Production Runtime)&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #99F6E4; margin: 5px 0;'&gt;• &lt;b&gt;Core Script:&lt;/b&gt; &lt;span style='font-family: monospace; color: #0F766E; font-weight: bold;'&gt;src/inference/engine.py&lt;/span&gt;&lt;br&gt;• &lt;b&gt;Pre-Trained Weights:&lt;/b&gt; Loaded from &lt;span style='font-family: monospace; color: #0F766E; font-weight: bold;'&gt;best_model.pt&lt;/span&gt; (Epoch 23)&lt;br&gt;• &lt;b&gt;Synchronized Runtime Feature Extraction:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Fast ResNet-50 appearance forward pass&lt;br&gt;&amp;nbsp;&amp;nbsp;- Keypoint R-CNN skeleton tracker + velocity cache&lt;br&gt;&amp;nbsp;&amp;nbsp;- Apparatus candidate scoring &amp;amp; kinematic engine&lt;br&gt;• &lt;b&gt;Inference Latency Profile:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Forward Pass Execution: &lt;b&gt;~18.4 ms / window&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Full End-to-End Latency: &lt;b&gt;&amp;lt; 33.3 ms (True 30+ FPS Real-Time)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Temporal Attention Saliency Extraction:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Extracts real-time frame importance weights α_t for live HUD display." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="540" y="2025" width="500" height="305" as="geometry" />
        </mxCell>
        <mxCell id="box_ui" value="&lt;div style='text-align: center; font-weight: bold; font-size: 13px; color: #115E59;'&gt;🖥️ Multi-Platform Deployment &amp;amp; Prediction HUD&lt;/div&gt;&lt;hr style='border: 0; border-top: 1px solid #99F6E4; margin: 5px 0;'&gt;• &lt;b&gt;Classification Outputs (82 Sports Classes):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- &lt;span style='color: #0F766E; font-weight: bold;'&gt;Top-1 Predicted Class&lt;/span&gt; (e.g., &lt;i&gt;TennisSwing 94.6%&lt;/i&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;- &lt;span style='color: #0F766E; font-weight: bold;'&gt;Top-5 Confidence Distribution&lt;/span&gt; bar chart&lt;br&gt;&amp;nbsp;&amp;nbsp;- Dynamic Temporal Attention Saliency timeline&lt;br&gt;• &lt;b&gt;Deployed Platforms &amp;amp; Interfaces:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;1. &lt;b&gt;Streamlit Web Dashboard:&lt;/b&gt; (&lt;span style='font-family: monospace;'&gt;app.py&lt;/span&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Interactive video upload, metric analytics, and ablation explorer.&lt;br&gt;&amp;nbsp;&amp;nbsp;2. &lt;b&gt;Desktop Native GUI:&lt;/b&gt; (&lt;span style='font-family: monospace;'&gt;src/ui/desktop_app.py&lt;/span&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Low-latency Tkinter multi-threaded application.&lt;br&gt;&amp;nbsp;&amp;nbsp;3. &lt;b&gt;Live Video Stream HUD:&lt;/b&gt; (&lt;span style='font-family: monospace;'&gt;src/ui/video_stream.py&lt;/span&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Real-time OpenCV webcam overlay with joint skeletons." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1070" y="2025" width="540" height="305" as="geometry" />
        </mxCell>
        <mxCell id="e_best_model_deploy" value="Serialized best_model.pt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0" edge="1" parent="1" source="box_eval" target="box_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_live_engine" value="16-Frame FIFO Buffer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0" edge="1" parent="1" source="box_live" target="box_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_engine_ui" value="Top-5 Probabilities &amp; Saliency" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0" edge="1" parent="1" source="box_engine" target="box_ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="caption_fig1" value="&lt;b&gt;Figure 1:&lt;/b&gt; Comprehensive Methodology Architecture of the Proposed CMAT-HOI Framework for Fine-Grained Sports Action Recognition. The pipeline systematically spans dataset ingestion &amp;amp; conditioning (Phase 1), synchronized 4-stream multimodal extraction (Phase 2), the core Cross-Modal Attention Transformer network (Phase 3), optimization with Focal Loss &amp;amp; disjoint evaluation (Phase 4), and real-time 30+ FPS multi-platform deployment (Phase 5)." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#475569;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="2370" width="1580" height="50" as="geometry" />
        </mxCell>
