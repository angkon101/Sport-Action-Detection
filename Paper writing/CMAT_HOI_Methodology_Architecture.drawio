        <mxCell id="b_sample" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" value="&lt;b style=&#39;font-size:12px; color:#1E40AF;&#39;&gt;Uniform Temporal Sampling&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#475569;&#39;&gt;Extract T = 16 Equidistant Frames (224 × 224 px)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="360" x="410" y="125" as="geometry" />
