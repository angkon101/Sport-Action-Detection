<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="CMAT_HOI_Simplified" name="Methodology Architecture">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;b style='font-size: 19px; color: #FFFFFF;'&gt;CMAT-HOI: System Methodology &amp;amp; Architecture Diagram&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 12px; color: #94A3B8;'&gt;End-to-End Multimodal Framework for Sports Action Recognition (82 Classes)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cont_p1" value="&lt;b&gt;STEP 1: DATA COLLECTION, PREPROCESSING FUNNEL &amp;amp; SPLITTING&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#0369A1;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="box_dataset" value="&lt;b style='font-size: 13px; color: #0284C7;'&gt;📁 Sports Action Dataset&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #BAE6FD; margin:4px 0;'&gt;• &lt;b&gt;UCF-101 Subset:&lt;/b&gt; 9,151 Videos&lt;br&gt;• &lt;b&gt;82 Action Categories:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Basketball, Tennis, Cricket,&lt;br&gt;&amp;nbsp;&amp;nbsp;Gymnastics, Diving, Boxing...&lt;br&gt;• &lt;b&gt;Input:&lt;/b&gt; Raw RGB Video Clips" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="250" height="185" as="geometry" />
        </mxCell>
        <mxCell id="box_funnel" value="&lt;b style='font-size: 13px; color: #0284C7;'&gt;⚙️ 5-Step Video Preprocessing Funnel&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #BAE6FD; margin:4px 0;'&gt;&lt;table width='100%' style='font-size: 11px; text-align: left;'&gt;&lt;tr&gt;&lt;td style='padding: 2px 0;'&gt;&lt;b&gt;1. Frame Sampling:&lt;/b&gt; Select 16 equidistant frames across each video&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding: 2px 0;'&gt;&lt;b&gt;2. Image Resizing:&lt;/b&gt; Resize frames to standard 224 × 224 pixels&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding: 2px 0;'&gt;&lt;b&gt;3. Motion Velocities:&lt;/b&gt; Compute speed and direction between consecutive frames&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding: 2px 0;'&gt;&lt;b&gt;4. Data Cleaning:&lt;/b&gt; Handle missing player joints and equipment bounding boxes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding: 2px 0;'&gt;&lt;b&gt;5. Normalization:&lt;/b&gt; Zero-center normalize pixels &amp;amp; package for model&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="340" y="135" width="590" height="185" as="geometry" />
        </mxCell>
        <mxCell id="box_split" value="&lt;b style='font-size: 13px; color: #0284C7;'&gt;⚖️ Dataset Split&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #BAE6FD; margin:4px 0;'&gt;&lt;div style='background:#EFF6FF; border:1px solid #3B82F6; border-radius:5px; padding:4px; margin-bottom:6px;'&gt;&lt;b&gt;🏋️ Training Set (70%)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1D4ED8; font-size:12px; font-weight:bold;'&gt;6,408 Video Clips&lt;/span&gt;&lt;br&gt;&lt;font style='font-size:9.5px; color:#64748B;'&gt;Used to train the neural network&lt;/font&gt;&lt;/div&gt;&lt;div style='background:#F0FDF4; border:1px solid #16A34A; border-radius:5px; padding:4px;'&gt;&lt;b&gt;🎯 Testing Set (30%)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#15803D; font-size:12px; font-weight:bold;'&gt;2,743 Video Clips&lt;/span&gt;&lt;br&gt;&lt;font style='font-size:9.5px; color:#64748B;'&gt;Unseen data to verify accuracy&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="960" y="135" width="380" height="185" as="geometry" />
        </mxCell>
        <mxCell id="e1_1" value="Raw Videos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#0369A1;" edge="1" parent="1" source="box_dataset" target="box_funnel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_2" value="Preprocessed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#0369A1;" edge="1" parent="1" source="box_funnel" target="box_split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cont_p2" value="&lt;b&gt;STEP 2: 4-STREAM MULTIMODAL FEATURE EXTRACTION (WHAT THE MODEL SEES)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#6B21A8;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s_vis" value="&lt;b style='font-size: 12.5px; color: #2563EB;'&gt;1. Visual Appearance&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 11px; font-weight: bold; color: #1E293B;'&gt;Model: ResNet-50&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #E2E8F0; margin:4px 0;'&gt;&lt;span style='font-size: 10px; color: #475569;'&gt;Background scene, sports arena,&lt;br&gt;court lines, player clothing&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="395" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="s_pose" value="&lt;b style='font-size: 12.5px; color: #059669;'&gt;2. Player Body Pose&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 11px; font-weight: bold; color: #1E293B;'&gt;Model: Keypoint R-CNN&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #E2E8F0; margin:4px 0;'&gt;&lt;span style='font-size: 10px; color: #475569;'&gt;17 human body joints (arms, legs)&lt;br&gt;+ Movement speed &amp;amp; angles&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="395" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="s_obj" value="&lt;b style='font-size: 12.5px; color: #D97706;'&gt;3. Sports Equipment&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 11px; font-weight: bold; color: #1E293B;'&gt;Model: Faster R-CNN&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #E2E8F0; margin:4px 0;'&gt;&lt;span style='font-size: 10px; color: #475569;'&gt;Ball, tennis racket, bat,&lt;br&gt;skateboard, barbell detection&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="395" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="s_hoi" value="&lt;b style='font-size: 12.5px; color: #DB2777;'&gt;4. Human-Object Action&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 11px; font-weight: bold; color: #1E293B;'&gt;Model: Interaction Engine&lt;/span&gt;&lt;hr style='border:0; border-top:1px solid #E2E8F0; margin:4px 0;'&gt;&lt;span style='font-size: 10px; color: #475569;'&gt;Hands/feet distance to equipment&lt;br&gt;+ Ball hit/release timing&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;padding=6;" vertex="1" parent="1">
          <mxGeometry x="1050" y="395" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e_train_extract" value="Extract Features from Training Videos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#6B21A8;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="box_split" target="s_obj">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cont_p3" value="&lt;b&gt;STEP 3: CMAT-HOI CORE NETWORK ARCHITECTURE&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=14;fontColor=#92400E;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1320" height="500" as="geometry" />
        </mxCell>
        <mxCell id="box_stems" value="&lt;b style='font-size: 12.5px; color: #92400E;'&gt;1. Modality Alignment (Stems)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 10.5px; color: #451A03;'&gt;Transforms all 4 streams (images, body joints, equipment, interactions) into a unified matching size (256 dimensions)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box_cross" value="&lt;b style='font-size: 12.5px; color: #831843;'&gt;2. Cross-Modal Attention (Body Pose ↔ Sports Equipment)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 10.5px; color: #4C0519;'&gt;Connects human movements directly with sports equipment: Helps the model know exactly &lt;i&gt;where&lt;/i&gt; the ball/racket is when the player swings or jumps.&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F8;strokeColor=#BE185D;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="1280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box_gmfu" value="&lt;b style='font-size: 12.5px; color: #78350F;'&gt;3. Smart Gated Fusion (Adaptive Modality Trust)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 10.5px; color: #451A03;'&gt;Automatically learns which stream is most trustworthy in each video frame:&lt;br&gt;• If body is occluded, rely more on equipment and scene &amp;nbsp;|&amp;nbsp; • At the moment of ball contact, give top priority to hand-object interaction!&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="1280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="box_trans" value="&lt;b style='font-size: 13px; color: #064E3B;'&gt;4. Spatio-Temporal Transformer (Learns Video Sequence Patterns)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 10.5px; color: #022C22;'&gt;Reads all 16 frames in chronological sequence using Self-Attention:&lt;br&gt;Understands the full athletic storyline from preparation $\to$ peak strike/jump $\to$ follow-through.&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="1280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="box_pool" value="&lt;b style='font-size: 12.5px; color: #0E7490;'&gt;5. Multi-Scale Temporal Pooling&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 10.5px; color: #164E63;'&gt;Combines 4 perspectives into one complete action signature: &lt;b&gt;Global Context&lt;/b&gt; + &lt;b&gt;Peak Fast Spike&lt;/b&gt; + &lt;b&gt;Average Flow&lt;/b&gt; + &lt;b&gt;Key Moments&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="1280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_s_stems" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.25;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="s_pose" target="box_stems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s_stems2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.75;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="s_obj" target="box_stems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_stem_cross" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;" edge="1" parent="1" source="box_stems" target="box_cross">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cross_gmfu" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;" edge="1" parent="1" source="box_cross" target="box_gmfu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gmfu_trans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;" edge="1" parent="1" source="box_gmfu" target="box_trans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_trans_pool" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#92400E;" edge="1" parent="1" source="box_trans" target="box_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cont_p4" value="&lt;b&gt;STEP 4: TRAINING OPTIMIZATION &amp;amp; INDEPENDENT EVALUATION&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#B91C1C;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="box_train_opt" value="&lt;b style='font-size: 13px; color: #B91C1C;'&gt;🎯 Model Training &amp;amp; Loss&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #FECACA; margin:4px 0;'&gt;• &lt;b&gt;Classifier:&lt;/b&gt; 3-Layer Neural Network&lt;br&gt;• &lt;b&gt;Loss:&lt;/b&gt; Focal Loss with Label Smoothing&lt;br&gt;&amp;nbsp;&amp;nbsp;(Prevents confusion between similar sports)&lt;br&gt;• &lt;b&gt;Optimizer:&lt;/b&gt; AdamW with Cosine Learning Rate&lt;br&gt;• &lt;b&gt;Augmentations:&lt;/b&gt; Mixup &amp;amp; Joint Jitter" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="60" y="1115" width="420" height="185" as="geometry" />
        </mxCell>
        <mxCell id="box_center_loop" value="&lt;b style='font-size: 14px; color: #1E293B;'&gt;CMAT-HOI Training Loop&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #CBD5E1; margin:6px 0;'&gt;&lt;span style='font-size: 11px; color: #475569;'&gt;The model adjusts millions of parameters epoch-by-epoch until it reaches peak recognition accuracy.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='background:#DCFCE7; border:1px solid #16A34A; color:#14532D; font-weight:bold; padding:4px 8px; border-radius:4px; font-size:11px;'&gt;Best Model Checkpoint: Epoch 23 (Saved to best_model.pt)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="510" y="1115" width="380" height="185" as="geometry" />
        </mxCell>
        <mxCell id="box_eval_res" value="&lt;b style='font-size: 13px; color: #15803D;'&gt;🏆 Test Evaluation (Unseen Data)&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #BBF7D0; margin:4px 0;'&gt;• &lt;b&gt;Evaluated on:&lt;/b&gt; 2,743 Independent Test Clips&lt;br&gt;&lt;div style='background:#ECFDF5; border:1.5px solid #059669; border-radius:5px; padding:6px; margin:6px 0; text-align:center;'&gt;&lt;b style='color:#065F46; font-size:14px;'&gt;Top-1 Accuracy: 90.19%&lt;/b&gt;&lt;br&gt;&lt;b style='color:#065F46; font-size:12px;'&gt;Top-5 Accuracy: 99.02%&lt;/b&gt;&lt;/div&gt;• &lt;b&gt;Validation Loss:&lt;/b&gt; 0.4397 (Lowest error)&lt;br&gt;• &lt;b&gt;Zero Data Leakage:&lt;/b&gt; Strictly separated actors" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="920" y="1115" width="420" height="185" as="geometry" />
        </mxCell>
        <mxCell id="e_pool_train" value="Unified Feature Vector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B91C1C;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="box_pool" target="box_center_loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_train_loss" value="Gradient Updates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B91C1C;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="box_train_opt" target="box_center_loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_eval_test" value="Validate on Test Data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#047857;;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="box_center_loop" target="box_eval_res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cont_p5" value="&lt;b&gt;STEP 5: REAL-TIME DEPLOYMENT &amp;amp; PREDICTION INTERFACES&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#047857;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1340" width="1320" height="220" as="geometry" />
        </mxCell>
