        <mxCell id="box_loss" value="&lt;b&gt;Focal Loss with Label Smoothing Regularization&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; font-weight:bold; color:#B91C1C;'&gt;L_focal = - ∑_(c=1)^82 α_c · (1 - p_c)^γ · y_c^(smooth) · log(p_c)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#475569;'&gt;γ = 1.5 (Focuses on hard sports) &amp;nbsp;|&amp;nbsp; α_c = 0.08 (Balances classes) &amp;nbsp;|&amp;nbsp; ε = 0.08 (Prevents overconfidence)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="1400" width="640" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_nn_loss" value="Predicted Logits ŷ ∈ ℝ^82" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="box_nn_graph" target="box_loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_loss_backprop" value="∇ L_focal (End-to-End Backpropagation)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;;exitX=0.15;exitY=0.0;exitDx=0;exitDy=0;entryX=0.15;entryY=1.0;entryDx=0;entryDy=0" edge="1" parent="1" source="box_loss" target="center_model">
          <mxGeometry relative="1" as="geometry" />
