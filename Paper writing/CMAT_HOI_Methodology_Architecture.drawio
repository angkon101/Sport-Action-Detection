        </mxCell>
        <mxCell id="m_pose" value="&lt;span style='font-size:9.5px;'&gt;Kinematic Pose&lt;br&gt;&lt;b&gt;Keypoint R-CNN&lt;/b&gt;&lt;br&gt;&lt;font color='#047857'&gt;&lt;b&gt;X_P ∈ ℝ^(16 × 85)&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.2;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
