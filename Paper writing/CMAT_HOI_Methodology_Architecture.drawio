        <mxCell id="box_hyper_right" value="&lt;b style='font-size:13px; color:#92400E;'&gt;Hyperparameter&lt;br&gt;Optimization&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #FDE68A; margin:6px 0;'&gt;&lt;table width='100%' style='font-size:10px; color:#334155; text-align:left; line-height:1.7;'&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Optimizer:&lt;/b&gt; AdamW&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Peak LR:&lt;/b&gt; 4 × 10^-4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Weight Decay:&lt;/b&gt; 1e-4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Scheduler:&lt;/b&gt; CosineAnnealing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Linear Warmup:&lt;/b&gt; 5 Epochs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Multimodal Mixup:&lt;/b&gt; β = 0.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Kinematic Jitter:&lt;/b&gt; σ = 0.008&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Frame Dropout:&lt;/b&gt; p = 0.25&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;shadow=1;fillColor=#FEF9E7;strokeColor=#D4AC0D;" vertex="1" parent="1">
