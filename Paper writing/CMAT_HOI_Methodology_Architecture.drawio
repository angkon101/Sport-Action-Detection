        <mxCell id="box_eval_left" value="&lt;b style='font-size:13px; color:#15803D;'&gt;Model Evaluation&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0; border-top:1px solid #BBF7D0; margin:6px 0;'&gt;&lt;span style='font-size:10px; color:#334155;'&gt;Independent Generalization:&lt;/span&gt;&lt;br&gt;&lt;div style='background:#DCFCE7; border:1px solid #16A34A; border-radius:5px; padding:6px; margin:6px 0; text-align:center;'&gt;&lt;b style='color:#14532D; font-size:13px;'&gt;Top-1 Accuracy: 90.19%&lt;/b&gt;&lt;br&gt;&lt;b style='color:#14532D; font-size:11.5px;'&gt;Top-5 Accuracy: 99.02%&lt;/b&gt;&lt;/div&gt;&lt;table width='100%' style='font-size:9.5px; color:#475569; text-align:left;'&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Val Loss:&lt;/b&gt; 0.4397&lt;/td&gt;&lt;td&gt;• &lt;b&gt;Epoch:&lt;/b&gt; 23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;Macro F1:&lt;/b&gt; 90.19%&lt;/td&gt;&lt;td&gt;• &lt;b&gt;Clips:&lt;/b&gt; 2,743&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;span style='font-size:9px; color:#64748B;'&gt;82×82 Normalized Confusion Matrix verification&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;shadow=1;fillColor=#F0FDF4;strokeColor=#16A34A;" vertex="1" parent="1">
