        </mxCell>
        <mxCell id="m_obj" value="&lt;span style='font-size:9.5px;'&gt;Sports Equipment&lt;br&gt;&lt;b&gt;Faster R-CNN&lt;/b&gt;&lt;br&gt;&lt;font color='#B45309'&gt;&lt;b&gt;X_O ∈ ℝ^(16 × 7)&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="472" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m_hoi" value="&lt;span style='font-size:9.5px;'&gt;Geometric HOI&lt;br&gt;&lt;b&gt;Kinematic Engine&lt;/b&gt;&lt;br&gt;&lt;font color='#BE185D'&gt;&lt;b&gt;X_H ∈ ℝ^(16 × 16)&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.2;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="472" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box_stems" value="&lt;b&gt;Dimension-Aligned Modality Stems (d = 256)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px; color:#451A03;'&gt;Linear(D_m → 256) + LayerNorm + Conv1D(k=3, p=1) + GELU ──► &lt;b&gt;H_V, H_P, H_O, H_H ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FEF9C3;strokeColor=#D97706;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="545" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_s_m_vis" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="m_vis" target="box_stems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s_m_pose" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="m_pose" target="box_stems">
