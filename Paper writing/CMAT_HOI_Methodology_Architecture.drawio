        </mxCell>
        <mxCell id="e_s_m_hoi" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="m_hoi" target="box_stems">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_cross" value="&lt;b&gt;Bi-Directional Keypoint–Equipment Cross-Attention Module (h = 4 Heads, d_k = 64)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#831843;'&gt;Pose queries Equipment: &lt;b&gt;P_enh = LayerNorm(H_P + MHA(Q_p, K_o, V_o))&lt;/b&gt;&lt;br&gt;Equipment queries Pose: &lt;b&gt;O_enh = LayerNorm(H_O + MHA(Q_o, K_p, V_p))&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F8;strokeColor=#BE185D;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="615" width="580" height="62" as="geometry" />
        </mxCell>
        <mxCell id="e_stems_cross" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="box_stems" target="box_cross">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_gmfu" value="&lt;b&gt;Gated Multimodal Fusion Unit (GMFU) — Dynamic Modality Gating&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#78350F;'&gt;Joint Token: &lt;b&gt;U_t = [H_V ; P_enh ; O_enh ; H_H] ∈ ℝ^1024&lt;/b&gt; ──► Gating MLP ──► &lt;b&gt;g_t = Softmax(s_t) ∈ ℝ^4&lt;/b&gt;&lt;br&gt;Dynamic Fused Frame Representation: &lt;b&gt;F_t = LayerNorm( ∑ g_t^(m) · X_t^(m) ) ∈ ℝ^256&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="695" width="580" height="58" as="geometry" />
        </mxCell>
        <mxCell id="e_cross_gmfu" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="box_cross" target="box_gmfu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_trans" value="&lt;b&gt;Spatio-Temporal Transformer Encoder (3 Layers, Pre-LayerNorm, 8 Heads)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#064E3B;'&gt;Input Sequence: &lt;b&gt;Z_0 = [ z_CLS ; F_1 ; F_2 ; ... ; F_16 ] + E_pos ∈ ℝ^(17 × 256)&lt;/b&gt;&lt;br&gt;Multi-Head Self-Attention (h = 8, d_k = 32) + FFN (d_ff = 1024, GELU) with Pre-LN Residual Skips&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="772" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_gmfu_trans" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="box_gmfu" target="box_trans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_pool" value="&lt;b&gt;Multi-Scale 4-Way Temporal Pooling Head (D_pooled = 1024)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#0E7490;'&gt;• &lt;b&gt;z_CLS&lt;/b&gt; (256-d): Global Context &amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp; • &lt;b&gt;z_Attn&lt;/b&gt; (256-d): Saliency ∑ α_t z_t&lt;br&gt;• &lt;b&gt;z_Max&lt;/b&gt; (256-d): Peak Motion &amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp; • &lt;b&gt;z_Avg&lt;/b&gt; (256-d): Baseline Flow&lt;br&gt;&lt;b&gt;Concatenated Vector: Z_video = [ z_CLS ; z_Attn ; z_Max ; z_Avg ] ∈ ℝ^1024&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="850" width="580" height="68" as="geometry" />
