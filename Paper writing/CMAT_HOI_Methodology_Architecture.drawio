        <mxCell id="lbl_streams" value="&lt;b&gt;Multimodal Input Streams (T = 16 Equidistant Frames)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#78350F;fontStyle=1;" vertex="1" parent="1">
