        <mxCell id="e_pool_nn" value="Z_video (1024-d)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="box_pool" target="box_nn_graph">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_loss" value="&lt;b&gt;Training Objective: Focal Loss with Label Smoothing Regularization&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; font-weight:bold; color:#B91C1C;'&gt;L_Focal = - (1/B) ∑_(i=1)^B ∑_(c=1)^82 α_c · (1 - p_i,c)^γ · y_i,c^(smooth) · log(p_i,c)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:9.5px; color:#475569;'&gt;γ = 1.5 (Focusing Parameter) &amp;nbsp;|&amp;nbsp; α_c = 0.08 (Class Balancing) &amp;nbsp;|&amp;nbsp; ε = 0.08 (Label Smoothing)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="1175" width="580" height="68" as="geometry" />
        </mxCell>
        <mxCell id="e_nn_loss" value="Action Logits ŷ ∈ ℝ^82" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" edge="1" parent="1" source="box_nn_graph" target="box_loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
