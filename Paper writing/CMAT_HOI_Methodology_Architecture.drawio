        <mxCell id="lbl_nn_annot" value="&lt;font color='#64748B' style='font-size:9.5px;'&gt;Linear(1024→512) + LN + GELU + Dropout(0.3) &amp;nbsp;──►&amp;nbsp; Linear(512→256) &amp;nbsp;──►&amp;nbsp; Linear(256→82 Classes)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
