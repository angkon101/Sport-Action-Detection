        <mxCell id="banner" parent="1" style="rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;html=1;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size: 17px; color: #FFFFFF;&#39;&gt;CMAT-HOI: System Model Architecture Diagram&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size: 11px; color: #94A3B8;&#39;&gt;Cross-Modal Attention Transformer with Human-Object Interaction for Sports Action Recognition (82 Classes)&lt;/span&gt;" vertex="1">
