        <mxCell id="b_seq" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#EFF6FF;strokeColor=#3B82F6;" value="&lt;b style=&#39;font-size:12px; color:#1E40AF;&#39;&gt;Synchronized Clip Sequence&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#475569;&#39;&gt;Sequence: { I_1, I_2, ..., I_16 } ∈ ℝ^(16 × 3 × 224 × 224)&lt;/span&gt;" vertex="1">
