        <mxCell id="m_vis" value="&lt;span style='font-size:9.5px;'&gt;Visual Appearance&lt;br&gt;&lt;b&gt;ResNet-50&lt;/b&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;X_V ∈ ℝ^(16 × 2048)&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
