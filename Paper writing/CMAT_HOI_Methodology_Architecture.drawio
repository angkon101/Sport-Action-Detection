        <mxCell id="g2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#334155;container=1;collapsible=0;" value="&lt;b&gt;2. MULTIMODAL FEATURE EXTRACTION (4 SYNCHRONIZED PARALLEL STREAMS)&lt;/b&gt;" vertex="1">
          <mxGeometry height="135" width="1120" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="b_vis" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#DBEAFE;strokeColor=#2563EB;" value="&lt;b style=&#39;font-size:12px; color:#1D4ED8;&#39;&gt;Visual Appearance Stream&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10.5px; font-weight:bold; color:#1E293B;&#39;&gt;ResNet-50 (avgpool)&lt;/span&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px; color:#2563EB;&#39;&gt;&lt;b&gt;X_vis ∈ ℝ^(16 × 2048)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="255" x="60" y="255" as="geometry" />
        </mxCell>
        <mxCell id="b_pose" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#D1FAE5;strokeColor=#059669;" value="&lt;b style=&#39;font-size:12px; color:#047857;&#39;&gt;Skeletal Kinematics Stream&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10.5px; font-weight:bold; color:#1E293B;&#39;&gt;Keypoint R-CNN (17 joints + vel)&lt;/span&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px; color:#059669;&#39;&gt;&lt;b&gt;X_pose ∈ ℝ^(16 × 85)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="255" x="345" y="255" as="geometry" />
        </mxCell>
        <mxCell id="b_obj" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FEF3C7;strokeColor=#D97706;" value="&lt;b style=&#39;font-size:12px; color:#B45309;&#39;&gt;Sports Apparatus Stream&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10.5px; font-weight:bold; color:#1E293B;&#39;&gt;Faster R-CNN (FPN Detection)&lt;/span&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px; color:#D97706;&#39;&gt;&lt;b&gt;X_obj ∈ ℝ^(16 × 7)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="255" x="630" y="255" as="geometry" />
        </mxCell>
        <mxCell id="b_hoi" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FCE7F3;strokeColor=#DB2777;" value="&lt;b style=&#39;font-size:12px; color:#BE185D;&#39;&gt;Geometric HOI Stream&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10.5px; font-weight:bold; color:#1E293B;&#39;&gt;Kinematic Interaction Engine&lt;/span&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px; color:#DB2777;&#39;&gt;&lt;b&gt;X_hoi ∈ ℝ^(16 × 16)&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="225" x="915" y="255" as="geometry" />
        </mxCell>
        <mxCell id="e_seq_ext" edge="1" parent="1" source="b_seq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" target="b_obj" value="Extract Streams">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#92400E;container=1;collapsible=0;" value="&lt;b&gt;3. PROPOSED CMAT-HOI NETWORK ARCHITECTURE&lt;/b&gt;" vertex="1">
          <mxGeometry height="480" width="1120" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="b_pool" parent="g3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#CFFAFE;strokeColor=#0891B2;" value="&lt;b style=&#39;font-size:12.5px; color:#0E7490;&#39;&gt;Multi-Scale 4-Way Temporal Pooling Head&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#164E63;&#39;&gt;Concatenation: &lt;b&gt;Z_pool = [ z_CLS (256-d) ; z_Attn (256-d) ; z_Max (256-d) ; z_Avg (256-d) ] ∈ ℝ^1024&lt;/b&gt; &amp;nbsp;(Unified Action Descriptor)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1040" x="-690" y="420" as="geometry" />
        </mxCell>
        <mxCell id="b_stems" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FEF9C3;strokeColor=#D97706;" value="&lt;b style=&#39;font-size:12.5px; color:#92400E;&#39;&gt;Unified Modality Alignment Stems (d = 256)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#451A03;&#39;&gt;Linear(in_dim → 256) + LayerNorm + 1D Conv(k=3, p=1) + GELU ──► &lt;b&gt;E_vis, E_pose, E_obj, E_hoi ∈ ℝ^(16 × 256)&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1040" x="80" y="410" as="geometry" />
        </mxCell>
        <mxCell id="b_cross" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FDF2F8;strokeColor=#BE185D;" value="&lt;b style=&#39;font-size:12.5px; color:#831843;&#39;&gt;Bi-Directional Keypoint–Equipment Cross-Attention Module (h = 4 Heads, d_k = 64)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#4C0519;&#39;&gt;Pose queries Equipment: &lt;b&gt;P_enh = LN(E_pose + MHA(Q_p, K_o, V_o))&lt;/b&gt; &amp;nbsp;◄──►&amp;nbsp; Equipment queries Pose: &lt;b&gt;O_enh = LN(E_obj + MHA(Q_o, K_p, V_p))&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1040" x="80" y="500" as="geometry" />
        </mxCell>
        <mxCell id="b_gmfu" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FEF3C7;strokeColor=#B45309;" value="&lt;b style=&#39;font-size:12.5px; color:#78350F;&#39;&gt;Gated Multimodal Fusion Unit (GMFU) — Dynamic Modality Attention Weighting&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#451A03;&#39;&gt;Gating Vector: &lt;b&gt;g_t = Softmax(W_g · [E_vis ; P_enh ; O_enh ; E_hoi] + b_g) ∈ ℝ^4&lt;/b&gt; &amp;nbsp;►&amp;nbsp; Fused Token: &lt;b&gt;F_t = ∑ g_t,m · E_m,t ∈ ℝ^256&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1040" x="80" y="590" as="geometry" />
        </mxCell>
        <mxCell id="b_trans" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#ECFDF5;strokeColor=#059669;" value="&lt;b style=&#39;font-size:12.5px; color:#064E3B;&#39;&gt;Spatio-Temporal Transformer Encoder (3 Layers, Pre-LayerNorm, 8 Heads, d_ff = 1024)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#022C22;&#39;&gt;Token Input Sequence: &lt;b&gt;Z_0 = [ z_CLS ; F_1 ; F_2 ; ... ; F_16 ] + E_pos ∈ ℝ^(17 × 256)&lt;/b&gt; &amp;nbsp;(Captures Full Temporal Motion Dynamics)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1040" x="80" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e_s_stems1" edge="1" parent="1" source="b_pose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.3;entryY=0.0;entryDx=0;entryDy=0" target="b_stems" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s_stems2" edge="1" parent="1" source="b_obj" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7;entryY=0.0;entryDx=0;entryDy=0" target="b_stems" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_stems_cross" edge="1" parent="1" source="b_stems" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;" target="b_cross" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cross_gmfu" edge="1" parent="1" source="b_cross" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;" target="b_gmfu" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gmfu_trans" edge="1" parent="1" source="b_gmfu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;" target="b_trans" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_trans_pool" edge="1" parent="1" source="b_trans" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;" target="b_pool" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#334155;container=1;collapsible=0;" value="&lt;b&gt;4. CLASSIFICATION HEAD, LOSS FORMULATION &amp;amp; RECOGNITION OUTPUT&lt;/b&gt;" vertex="1">
          <mxGeometry height="195" width="1120" x="10" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="b_mlp" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FEE2E2;strokeColor=#DC2626;" value="&lt;b style=&#39;font-size:12px; color:#B91C1C;&#39;&gt;3-Layer MLP Classifier Head&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#334155;&#39;&gt;Linear(1024 → 512) + LN + GELU + Drop(0.3)&lt;br&gt;──► Linear(512 → 256) ──► Linear(256 → 82)&lt;br&gt;&lt;b&gt;Logits: ŷ ∈ ℝ^82&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="330" x="50" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="b_loss" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FFF1F2;strokeColor=#E11D48;" value="&lt;b style=&#39;font-size:12px; color:#9F1239;&#39;&gt;Focal Loss with Label Smoothing&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px; color:#334155;&#39;&gt;&lt;b&gt;L_focal = - ∑ α_c · (1 - p_c)^γ · y_c^(smooth) · log(p_c)&lt;/b&gt;&lt;br&gt;Focusing γ = 1.5, Balancing α_c = 0.08, Smoothing ε = 0.08&lt;br&gt;AdamW (lr=1e-4) + Cosine Annealing&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="340" x="410" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="b_eval" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#DCFCE7;strokeColor=#16A34A;" value="&lt;b style=&#39;font-size:12px; color:#15803D;&#39;&gt;82-Class Action Recognition&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:11.5px; font-weight:bold; color:#14532D;&#39;&gt;Top-1 Accuracy: 90.19%&lt;br&gt;Top-5 Accuracy: 99.02%&lt;/span&gt;&lt;br&gt;&lt;font style=&#39;font-size:9.5px; color:#166534;&#39;&gt;Evaluated on 2,743 Disjoint Test Clips (Peak Epoch 23)&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="350" x="780" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="e_pool_mlp" edge="1" parent="1" source="b_pool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;;exitX=0.2;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0" target="b_mlp" value="Z_pool (1024-d)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mlp_loss" edge="1" parent="1" source="b_mlp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;" target="b_loss" value="Logits ŷ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_loss_eval" edge="1" parent="1" source="b_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;" target="b_eval" value="Validation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_loss_backprop" edge="1" parent="1" source="b_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0" target="b_trans" value="∇ Loss (Backpropagation)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cap" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#475569;fontStyle=2;" value="&lt;b&gt;Fig. 1.&lt;/b&gt; System Model Architecture of the Proposed CMAT-HOI Framework for Sports Action Recognition (82 Classes)." vertex="1">
