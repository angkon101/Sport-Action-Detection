        <mxCell id="b_gmfu" value="&lt;b style='font-size:12.5px; color:#78350F;'&gt;Gated Multimodal Fusion Unit (GMFU)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px; color:#451A03;'&gt;Dynamic Modality Weights: g_t = Softmax(W_g · [V ; P ; O ; H]) &amp;nbsp;►&amp;nbsp; Fused Token F_t&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;fillColor=#FEF3C7;strokeColor=#B45309;" vertex="1" parent="1">
