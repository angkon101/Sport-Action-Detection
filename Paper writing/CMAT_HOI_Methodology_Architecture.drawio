        <mxCell id="box_final_out" value="&lt;b style='font-size:13px; color:#15803D;'&gt;Fine-Grained Sports Action Output (82 Classes)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px; color:#334155;'&gt;Top-1 &amp;amp; Top-5 Predicted Categories (e.g. &lt;i&gt;TennisSwing 94.6%&lt;/i&gt;, &lt;i&gt;HighJump 92.1%&lt;/i&gt;)&lt;/span&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;html=1;align=center;verticalAlign=middle;shadow=1;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1">
